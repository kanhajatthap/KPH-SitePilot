{
  "name": "@wp-agent/api",
  "version": "0.1.0",
  "private": true,
  "description": "Node HTTP adapter and health endpoint for the KPH SitePilot API core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@wp-agent/config": "workspace:*",
    "@wp-agent/contracts": "workspace:*",
    "@wp-agent/audit": "workspace:*",
    "@wp-agent/model-adapters": "workspace:*",
    "@wp-agent/agent-core": "workspace:*",
    "@wp-agent/wp-client": "workspace:*",
    "zod": "^3.24.2",
    "@wp-agent/api-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}

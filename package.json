{
  "name": "wp-agent-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "KPH SitePilot / wp-agent \u2014 Provider-independent AI WordPress agent monorepo",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "turbo run build --concurrency=1",
    "typecheck": "turbo run typecheck && pnpm typecheck:edge",
    "typecheck:edge": "tsc --noEmit -p supabase/functions/tsconfig.json",
    "test": "turbo run test",
    "test:live": "pnpm --filter @wp-agent/model-adapters test:live",
    "test:wp:live": "pnpm --filter @wp-agent/agent-core test:live",
    "start:api": "pnpm --filter @wp-agent/api start",
    "dev:dashboard": "pnpm --filter @wp-agent/dashboard dev",
    "start:dashboard": "pnpm --filter @wp-agent/dashboard start",
    "lint": "turbo run lint && node scripts/php-lint.mjs && node scripts/governance-audit.mjs && node scripts/secret-audit.mjs && pnpm typecheck:edge",
    "lint:php": "node scripts/php-lint.mjs",
    "connector:zip": "bash scripts/build-connector-zip.sh",
    "test:php": "php wordpress/kph-sitepilot-connector/tests/test-plugin.php && php wordpress/kph-sitepilot-connector/tests/test-protocol.php && php wordpress/wp-agent-bridge/tests/test-plugin.php",
    "release:check": "node scripts/release-check.mjs",
    "release:plan": "node scripts/release-check.mjs --plan",
    "abuse:load": "node scripts/abuse-load.mjs"
  },
  "devDependencies": {
    "php-parser": "^3.7.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}

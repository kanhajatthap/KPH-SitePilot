# Environment configuration template for KPH SitePilot / wp-agent
# Copy to .env.local for local overrides. Never commit actual secrets or credentials.

# Application Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# WordPress Local Test Target
# Must be a valid local development domain (e.g. plugin-test.local or localhost)
WP_SITE_URL=http://plugin-test.local

# WordPress REST API Credentials (Application Password)
# Use site-specific revocable application passwords created in WordPress admin.
# Never use your primary administrator login password.
WP_APPLICATION_USERNAME=agent_local_user
WP_APPLICATION_PASSWORD=xxxx-xxxx-xxxx-xxxx

# AI Model Provider (Optional / Mock default in Phase 1)
AI_PROVIDER=mock
AI_MODEL=mock-model

# Google AI Studio / Gemini API (Phase 2 integration)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_PROJECT_ID=projects/your_project_id
GOOGLE_PROJECT_NUMBER=your_project_number

# OpenRouter API (Provider-independent alternative with verified free tool-calling model)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free

# Optional hosted SaaS mode (use the Supabase anon/publishable key only in the dashboard).
# When unset, the existing local-only workflow remains active.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin used inside auth emails (confirmation + password reset).
# Set this on any deployment: without it the app falls back to VERCEL_URL, and
# locally to http://localhost:3002 — which nobody else can open.
# See docs/email-deliverability.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Server-only override, takes precedence over NEXT_PUBLIC_SITE_URL.
SITEPILOT_SITE_URL=

# App-side mailer (optional, but it removes the dependency on Supabase SMTP).
# With these set, the app mints the confirmation/recovery link itself and sends
# the mail through Resend; with them unset, everything falls back to Supabase's
# mailer exactly as before. The key lives in the host environment only.
RESEND_API_KEY=
# Bare address or `Name <address>`; the domain must be verified in Resend.
SITEPILOT_MAIL_FROM=
# Optional Reply-To, ignored when it is not a valid address.
SITEPILOT_MAIL_REPLY_TO=

# Daily cron (`/api/cron/daily`): purge expired connector state + keep-alive.
# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`. With it unset the
# endpoint answers 503 and never runs unauthenticated.
# Generate with: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
CRON_SECRET=

# Per-user free-tier quotas (defaults: 200 AI messages, 100 plans, 500 site jobs per day).
# Override only to lower or raise a ceiling; invalid values fall back to the default.
SITEPILOT_QUOTA_AI=
SITEPILOT_QUOTA_PLAN=
SITEPILOT_QUOTA_JOB=

# Planner mode on hosted deployments: `auto` (use caller BYOK key, fall back to
# deterministic grammar), `model` (require BYOK key), or `deterministic`.
SITEPILOT_PLANNER=auto
SITEPILOT_PLANNER_TIMEOUT_MS=12000

# Auth email delivery (confirmation, recovery) is configured in the Supabase
# dashboard, not here: custom SMTP + Site URL + redirect allow list.
# The default Supabase mailer only reaches project members.

# Server-only Supabase service role key (connector pairing: sites, pairing codes).
# Never expose this to the browser and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key used to encrypt per-site connector secrets at rest.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SITEPILOT_ENCRYPTION_KEY=

# Optional local demo account card on /login (server-side env, rendered only there).
# Leave both blank in production. Never put real credentials here.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=

# Edge Function secrets only. Never add these to NEXT_PUBLIC_* variables or dashboard env.
# Configure in the Supabase local secrets file / deployment secret manager when authorized.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VAULT_MASTER_KEY=
DASHBOARD_ORIGIN=http://localhost:3002

{
  "name": "@wp-agent/connector-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Signed request protocol shared by the SitePilot platform and the WordPress connector plugin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}

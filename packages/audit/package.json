{
  "name": "@wp-agent/audit",
  "version": "0.1.0",
  "private": true,
  "description": "Structured, redacted audit logging engine for KPH SitePilot",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "pretest": "node -e \"if (!require('node:fs').existsSync('./dist/index.js')) require('node:child_process').execSync('pnpm run build', { stdio: 'inherit' })\"",
    "test": "vitest run",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@wp-agent/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}
